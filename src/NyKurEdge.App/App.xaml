<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="NyKurEdge.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NyKurEdge.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <Color x:Key="NyKurSurfaceColor">#D9101318</Color>
            <Color x:Key="NyKurCardColor">#681B2028</Color>
            <Color x:Key="NyKurTextColor">#FFF4F6F9</Color>
            <Color x:Key="NyKurMutedTextColor">#FF9298A5</Color>
            <Color x:Key="NyKurAccentColor">#FF7286E8</Color>

            <SolidColorBrush x:Key="NyKurSurfaceBrush" Color="{StaticResource NyKurSurfaceColor}" />
            <SolidColorBrush x:Key="NyKurCardBrush" Color="{StaticResource NyKurCardColor}" />
            <SolidColorBrush x:Key="NyKurTextBrush" Color="{StaticResource NyKurTextColor}" />
            <SolidColorBrush x:Key="NyKurMutedTextBrush" Color="{StaticResource NyKurMutedTextColor}" />
            <SolidColorBrush x:Key="NyKurAccentBrush" Color="{StaticResource NyKurAccentColor}" />
            <SolidColorBrush x:Key="NyKurAccentSoftBrush" Color="#507286E8" />
            <SolidColorBrush x:Key="NyKurAccentFaintBrush" Color="#187286E8" />
            <SolidColorBrush x:Key="NyKurGlassTraceBrush" Color="#8CEFF4F8" />
            <SolidColorBrush x:Key="NyKurHairlineBrush" Color="#24FFFFFF" />
            <SolidColorBrush x:Key="NyKurSoftHairlineBrush" Color="#12FFFFFF" />
            <SolidColorBrush x:Key="NyKurElevatedGlassBrush" Color="#7A171B22" />
            <SolidColorBrush x:Key="NyKurQuietGlassBrush" Color="#461B2028" />
            <SolidColorBrush x:Key="NyKurDeepGlassBrush" Color="#B20D1015" />

            <!-- Keep native controls inside NyKur Edge's single-accent visual system. -->
            <StaticResource x:Key="SliderThumbBackground" ResourceKey="NyKurAccentBrush" />
            <StaticResource x:Key="SliderThumbBackgroundPointerOver" ResourceKey="NyKurAccentBrush" />
            <StaticResource x:Key="SliderThumbBackgroundPressed" ResourceKey="NyKurAccentBrush" />
            <StaticResource x:Key="SliderTrackValueFill" ResourceKey="NyKurAccentBrush" />
            <StaticResource x:Key="SliderTrackValueFillPointerOver" ResourceKey="NyKurAccentBrush" />
            <StaticResource x:Key="SliderTrackValueFillPressed" ResourceKey="NyKurAccentBrush" />
            <StaticResource x:Key="ToggleSwitchFillOn" ResourceKey="NyKurAccentBrush" />
            <StaticResource x:Key="ToggleSwitchFillOnPointerOver" ResourceKey="NyKurAccentBrush" />
            <StaticResource x:Key="ToggleSwitchFillOnPressed" ResourceKey="NyKurAccentBrush" />
            <StaticResource x:Key="ToggleSwitchStrokeOn" ResourceKey="NyKurAccentBrush" />
            <StaticResource x:Key="ToggleSwitchStrokeOnPointerOver" ResourceKey="NyKurAccentBrush" />
            <StaticResource x:Key="ToggleSwitchStrokeOnPressed" ResourceKey="NyKurAccentBrush" />

            <Style x:Key="NyKurIconButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Foreground" Value="{StaticResource NyKurTextBrush}" />
                <Setter Property="Background" Value="#0AFFFFFF" />
                <Setter Property="BorderBrush" Value="{StaticResource NyKurSoftHairlineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <Style
                x:Key="NyKurTransportButtonStyle"
                BasedOn="{StaticResource NyKurIconButtonStyle}"
                TargetType="Button">
                <Setter Property="Width" Value="38" />
                <Setter Property="Height" Value="38" />
                <Setter Property="CornerRadius" Value="19" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="Background" Value="#08FFFFFF" />
                <Setter Property="BorderBrush" Value="#0FFFFFFF" />
            </Style>

            <Style
                x:Key="NyKurPrimaryTransportButtonStyle"
                BasedOn="{StaticResource NyKurTransportButtonStyle}"
                TargetType="Button">
                <Setter Property="Width" Value="46" />
                <Setter Property="Height" Value="46" />
                <Setter Property="CornerRadius" Value="23" />
                <Setter Property="Background" Value="{StaticResource NyKurAccentBrush}" />
                <Setter Property="BorderBrush" Value="#5CFFFFFF" />
                <Setter Property="Foreground" Value="#FF090B0E" />
            </Style>

            <Style x:Key="NyKurTextButtonStyle" TargetType="Button">
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource NyKurTextBrush}" />
                <Setter Property="Background" Value="#0CFFFFFF" />
                <Setter Property="BorderBrush" Value="{StaticResource NyKurSoftHairlineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <Style x:Key="NyKurGlassSectionStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource NyKurQuietGlassBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource NyKurSoftHairlineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="22" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <Style x:Key="NyKurHeroSurfaceStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource NyKurElevatedGlassBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource NyKurHairlineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="26" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <Style x:Key="NyKurSectionLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="145" />
                <Setter Property="Foreground" Value="{StaticResource NyKurMutedTextBrush}" />
            </Style>

            <Style x:Key="NyKurBodyTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
                <Setter Property="FontSize" Value="19" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource NyKurTextBrush}" />
            </Style>

            <Style x:Key="NyKurCaptionStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{StaticResource NyKurMutedTextBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
