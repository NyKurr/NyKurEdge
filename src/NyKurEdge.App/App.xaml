<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="NyKurEdge.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NyKurEdge.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <Color x:Key="NyKurSurfaceColor">#F214161A</Color>
            <Color x:Key="NyKurCardColor">#E61C1F25</Color>
            <Color x:Key="NyKurTextColor">#FFF5F6FA</Color>
            <Color x:Key="NyKurMutedTextColor">#FF8B909D</Color>
            <Color x:Key="NyKurAccentColor">#FF7286E8</Color>

            <SolidColorBrush x:Key="NyKurSurfaceBrush" Color="{StaticResource NyKurSurfaceColor}" />
            <SolidColorBrush x:Key="NyKurCardBrush" Color="{StaticResource NyKurCardColor}" />
            <SolidColorBrush x:Key="NyKurTextBrush" Color="{StaticResource NyKurTextColor}" />
            <SolidColorBrush x:Key="NyKurMutedTextBrush" Color="{StaticResource NyKurMutedTextColor}" />
            <SolidColorBrush x:Key="NyKurAccentBrush" Color="{StaticResource NyKurAccentColor}" />
            <SolidColorBrush x:Key="NyKurAccentSoftBrush" Color="#507286E8" />
            <SolidColorBrush x:Key="NyKurAccentFaintBrush" Color="#187286E8" />
            <SolidColorBrush x:Key="NyKurGlassTraceBrush" Color="#8CEFF4F8" />

            <!-- Keep native controls inside NyKur Edge's single-accent visual system. -->
            <StaticResource x:Key="SliderThumbBackground" ResourceKey="NyKurAccentBrush" />
            <StaticResource x:Key="SliderThumbBackgroundPointerOver" ResourceKey="NyKurAccentBrush" />
            <StaticResource x:Key="SliderThumbBackgroundPressed" ResourceKey="NyKurAccentBrush" />
            <StaticResource x:Key="SliderTrackValueFill" ResourceKey="NyKurAccentBrush" />
            <StaticResource x:Key="SliderTrackValueFillPointerOver" ResourceKey="NyKurAccentBrush" />
            <StaticResource x:Key="SliderTrackValueFillPressed" ResourceKey="NyKurAccentBrush" />
            <StaticResource x:Key="ToggleSwitchFillOn" ResourceKey="NyKurAccentBrush" />
            <StaticResource x:Key="ToggleSwitchFillOnPointerOver" ResourceKey="NyKurAccentBrush" />
            <StaticResource x:Key="ToggleSwitchFillOnPressed" ResourceKey="NyKurAccentBrush" />
            <StaticResource x:Key="ToggleSwitchStrokeOn" ResourceKey="NyKurAccentBrush" />
            <StaticResource x:Key="ToggleSwitchStrokeOnPointerOver" ResourceKey="NyKurAccentBrush" />
            <StaticResource x:Key="ToggleSwitchStrokeOnPressed" ResourceKey="NyKurAccentBrush" />

            <Style x:Key="NyKurIconButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Foreground" Value="{StaticResource NyKurTextBrush}" />
                <Setter Property="Background" Value="#12FFFFFF" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <Style x:Key="NyKurSectionLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="120" />
                <Setter Property="Foreground" Value="{StaticResource NyKurMutedTextBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
