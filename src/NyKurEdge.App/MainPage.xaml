<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="NyKurEdge.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <Grid
        x:Name="InteractionRoot"
        Background="#01000000"
        PointerEntered="OnPointerEntered"
        PointerExited="OnPointerExited">
        <Grid
            x:Name="LayoutGrid"
            Width="82"
            HorizontalAlignment="Left">
            <Border
                x:Name="ExpandedSurface"
                Background="{StaticResource NyKurSurfaceBrush}"
                CornerRadius="22,0,0,22"
                IsHitTestVisible="False"
                Opacity="0"
                Visibility="Collapsed" />

            <Grid
                x:Name="PanelContent"
                Margin="12,18,24,18"
                IsHitTestVisible="False"
                Opacity="0"
                RenderTransformOrigin="0.5,0.5"
                Visibility="Collapsed">
                    <Grid.RenderTransform>
                        <CompositeTransform x:Name="PanelTransform" TranslateX="12" />
                    </Grid.RenderTransform>

                    <ScrollViewer
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Hidden"
                        VerticalScrollMode="Auto">
                        <Grid>
                            <StackPanel x:Name="HomePane" Spacing="14">
                                <Grid Margin="4,0,2,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        Width="38"
                                        Height="38"
                                        Background="{StaticResource NyKurAccentFaintBrush}"
                                        CornerRadius="12">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource NyKurAccentBrush}"
                                            Text="NE" />
                                    </Border>

                                    <StackPanel
                                        Grid.Column="1"
                                        Margin="12,1,0,0"
                                        VerticalAlignment="Center">
                                        <TextBlock
                                            Style="{StaticResource NyKurSectionLabelStyle}"
                                            Text="NYKUR EDGE" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            FontSize="12"
                                            Foreground="{StaticResource NyKurMutedTextBrush}"
                                            Text="Ambient desktop companion" />
                                    </StackPanel>

                                    <Button
                                        Grid.Column="2"
                                        Margin="0,0,6,0"
                                        AutomationProperties.Name="Preview clock glance"
                                        Click="OnPreviewClockClicked"
                                        Content="{x:Bind ViewModel.HeaderTime, Mode=OneWay}"
                                        FontFamily="Segoe UI Variable Text"
                                        FontSize="12"
                                        Style="{StaticResource NyKurIconButtonStyle}" />

                                    <Button
                                        Grid.Column="3"
                                        AutomationProperties.Name="Settings"
                                        Click="OnSettingsClicked"
                                        Content="&#xE713;"
                                        Style="{StaticResource NyKurIconButtonStyle}" />
                                </Grid>

                                <Border
                                    Background="{StaticResource NyKurCardBrush}"
                                    CornerRadius="20"
                                    Padding="16">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="78" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Grid Width="66" Height="66">
                                            <Border
                                                Background="{StaticResource NyKurAccentFaintBrush}"
                                                CornerRadius="16">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="15"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource NyKurAccentBrush}"
                                                    Text="NE" />
                                            </Border>
                                            <Border CornerRadius="16">
                                                <Image
                                                    Source="{x:Bind ViewModel.Artwork, Mode=OneWay}"
                                                    Stretch="UniformToFill" />
                                            </Border>
                                        </Grid>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock
                                                Style="{StaticResource NyKurSectionLabelStyle}"
                                                Text="{x:Bind ViewModel.MediaSource, Mode=OneWay}" />
                                            <TextBlock
                                                Margin="0,6,0,0"
                                                FontSize="17"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource NyKurTextBrush}"
                                                MaxLines="1"
                                                Text="{x:Bind ViewModel.MediaTitle, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Margin="0,3,0,0"
                                                FontSize="13"
                                                Foreground="{StaticResource NyKurMutedTextBrush}"
                                                MaxLines="1"
                                                Text="{x:Bind ViewModel.MediaArtist, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,15,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Slider
                                                x:Name="MediaProgressSlider"
                                                Height="20"
                                                IsEnabled="{x:Bind ViewModel.IsMediaAvailable, Mode=OneWay}"
                                                Maximum="1"
                                                Minimum="0"
                                                PointerReleased="OnMediaProgressPointerReleased"
                                                Value="{x:Bind ViewModel.MediaProgress, Mode=OneWay}" />
                                            <Grid Grid.Row="1" Margin="4,-2,4,0">
                                                <TextBlock
                                                    FontSize="10"
                                                    Foreground="{StaticResource NyKurMutedTextBrush}"
                                                    Text="{x:Bind ViewModel.PositionText, Mode=OneWay}" />
                                                <TextBlock
                                                    HorizontalAlignment="Right"
                                                    FontSize="10"
                                                    Foreground="{StaticResource NyKurMutedTextBrush}"
                                                    Text="{x:Bind ViewModel.DurationText, Mode=OneWay}" />
                                            </Grid>
                                        </Grid>

                                        <StackPanel
                                            Grid.Row="2"
                                            Grid.ColumnSpan="2"
                                            Margin="0,10,0,0"
                                            HorizontalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="10">
                                            <Button
                                                AutomationProperties.Name="Previous track"
                                                Click="OnPreviousClicked"
                                                Content="&#xE892;"
                                                IsEnabled="{x:Bind ViewModel.IsMediaAvailable, Mode=OneWay}"
                                                Style="{StaticResource NyKurIconButtonStyle}" />
                                            <Button
                                                AutomationProperties.Name="Play or pause"
                                                Background="{StaticResource NyKurAccentBrush}"
                                                Click="OnPlayPauseClicked"
                                                Content="{x:Bind ViewModel.PlayPauseGlyph, Mode=OneWay}"
                                                Foreground="#FF090A0D"
                                                IsEnabled="{x:Bind ViewModel.IsMediaAvailable, Mode=OneWay}"
                                                Style="{StaticResource NyKurIconButtonStyle}" />
                                            <Button
                                                AutomationProperties.Name="Next track"
                                                Click="OnNextClicked"
                                                Content="&#xE893;"
                                                IsEnabled="{x:Bind ViewModel.IsMediaAvailable, Mode=OneWay}"
                                                Style="{StaticResource NyKurIconButtonStyle}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border
                                    Background="#99191C21"
                                    CornerRadius="18"
                                    Padding="15">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Grid Width="34" Height="34">
                                            <Border
                                                Background="{StaticResource NyKurAccentFaintBrush}"
                                                CornerRadius="11">
                                                <FontIcon
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="14"
                                                    Foreground="{StaticResource NyKurAccentBrush}"
                                                    Glyph="&#xEA8F;" />
                                            </Border>
                                            <Border CornerRadius="11">
                                                <Image
                                                    Source="{x:Bind ViewModel.NotificationIcon, Mode=OneWay}"
                                                    Stretch="UniformToFill" />
                                            </Border>
                                        </Grid>

                                        <StackPanel Grid.Column="1" Margin="10,0,8,0">
                                            <TextBlock
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource NyKurAccentBrush}"
                                                Text="{x:Bind ViewModel.NotificationApplication, Mode=OneWay}" />
                                            <TextBlock
                                                Margin="0,4,0,0"
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource NyKurTextBrush}"
                                                MaxLines="1"
                                                Text="{x:Bind ViewModel.NotificationTitle, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Margin="0,3,0,0"
                                                FontSize="12"
                                                Foreground="{StaticResource NyKurMutedTextBrush}"
                                                MaxLines="2"
                                                Text="{x:Bind ViewModel.NotificationMessage, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="Wrap" />
                                        </StackPanel>

                                        <TextBlock
                                            Grid.Column="2"
                                            FontSize="10"
                                            Foreground="{StaticResource NyKurMutedTextBrush}"
                                            Text="{x:Bind ViewModel.NotificationTime, Mode=OneWay}" />
                                    </Grid>
                                </Border>

                                <Grid Margin="5,2,5,0">
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{StaticResource NyKurMutedTextBrush}"
                                        Text="Primary display · Procedural motion" />
                                    <Ellipse
                                        x:Name="HomeStatusDot"
                                        Width="5"
                                        Height="5"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Fill="{StaticResource NyKurAccentBrush}"
                                        Opacity="0.72" />
                                </Grid>
                            </StackPanel>

                            <StackPanel
                                x:Name="SettingsPane"
                                Visibility="Collapsed"
                                Spacing="14">
                                <Grid Margin="2,0,2,2">
                                    <Button
                                        AutomationProperties.Name="Back"
                                        Click="OnSettingsBackClicked"
                                        Content="&#xE72B;"
                                        Style="{StaticResource NyKurIconButtonStyle}" />
                                    <StackPanel Margin="52,1,0,0" VerticalAlignment="Center">
                                        <TextBlock
                                            FontSize="17"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource NyKurTextBrush}"
                                            Text="Settings" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            FontSize="11"
                                            Foreground="{StaticResource NyKurMutedTextBrush}"
                                            Text="Quiet defaults, only useful controls" />
                                    </StackPanel>
                                </Grid>

                                <Border
                                    Background="{StaticResource NyKurCardBrush}"
                                    CornerRadius="18"
                                    Padding="16">
                                    <StackPanel Spacing="12">
                                        <TextBlock Style="{StaticResource NyKurSectionLabelStyle}" Text="GENERAL" />
                                        <ToggleSwitch
                                            x:Name="StartupToggle"
                                            Header="Launch with Windows"
                                            Toggled="OnStartupToggled" />
                                        <Grid>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Foreground="{StaticResource NyKurTextBrush}"
                                                Text="Screen edge" />
                                            <ComboBox
                                                x:Name="EdgeSideCombo"
                                                MinWidth="118"
                                                HorizontalAlignment="Right"
                                                SelectionChanged="OnEdgeSideChanged">
                                                <ComboBoxItem Content="Left" Tag="Left" />
                                                <ComboBoxItem Content="Right" Tag="Right" />
                                            </ComboBox>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border
                                    Background="{StaticResource NyKurCardBrush}"
                                    CornerRadius="18"
                                    Padding="16">
                                    <StackPanel Spacing="12">
                                        <TextBlock Style="{StaticResource NyKurSectionLabelStyle}" Text="APPEARANCE" />
                                        <Grid>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Foreground="{StaticResource NyKurTextBrush}"
                                                Text="Accent" />
                                            <ComboBox
                                                x:Name="AccentModeCombo"
                                                MinWidth="132"
                                                HorizontalAlignment="Right"
                                                SelectionChanged="OnAccentModeChanged">
                                                <ComboBoxItem Content="Automatic" Tag="Automatic" />
                                                <ComboBoxItem Content="Manual" Tag="Manual" />
                                            </ComboBox>
                                        </Grid>
                                        <Border
                                            x:Name="ManualAccentContainer"
                                            Background="#10000000"
                                            CornerRadius="14"
                                            Padding="8">
                                            <ColorPicker
                                                x:Name="ManualAccentPicker"
                                                HorizontalAlignment="Stretch"
                                                ColorChanged="OnManualAccentChanged"
                                                IsAlphaEnabled="False"
                                                IsAlphaSliderVisible="False"
                                                IsAlphaTextInputVisible="False"
                                                IsColorChannelTextInputVisible="False"
                                                IsHexInputVisible="False"
                                                IsMoreButtonVisible="False"
                                                IsColorPreviewVisible="True" />
                                        </Border>
                                        <Grid>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Foreground="{StaticResource NyKurTextBrush}"
                                                Text="Motion" />
                                            <ComboBox
                                                x:Name="AnimationIntensityCombo"
                                                MinWidth="132"
                                                HorizontalAlignment="Right"
                                                SelectionChanged="OnAnimationIntensityChanged">
                                                <ComboBoxItem Content="Quiet" Tag="Quiet" />
                                                <ComboBoxItem Content="Balanced" Tag="Balanced" />
                                                <ComboBoxItem Content="Expressive" Tag="Expressive" />
                                            </ComboBox>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border
                                    Background="{StaticResource NyKurCardBrush}"
                                    CornerRadius="18"
                                    Padding="16">
                                    <StackPanel Spacing="12">
                                        <TextBlock Style="{StaticResource NyKurSectionLabelStyle}" Text="MODULES" />
                                        <ToggleSwitch
                                            x:Name="MediaToggle"
                                            Header="Windows media"
                                            Toggled="OnMediaToggled" />
                                        <ToggleSwitch
                                            x:Name="NotificationToggle"
                                            Header="Notifications"
                                            Toggled="OnNotificationToggled" />
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{StaticResource NyKurMutedTextBrush}"
                                            Text="{x:Bind ViewModel.NotificationAccessLabel, Mode=OneWay}" />
                                        <Button
                                            x:Name="NotificationAccessButton"
                                            HorizontalAlignment="Left"
                                            Click="OnNotificationAccessClicked"
                                            Content="Request notification access" />
                                        <Border
                                            Background="{StaticResource NyKurAccentFaintBrush}"
                                            CornerRadius="12"
                                            Padding="12">
                                            <StackPanel Spacing="7">
                                                <TextBlock
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource NyKurTextBrush}"
                                                    Text="Avoid duplicate banners" />
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{StaticResource NyKurMutedTextBrush}"
                                                    Text="Keep notifications enabled, then turn off Windows banners (and sound if desired) for each app NyKur Edge should present. Windows does not expose a supported pre-banner interception API."
                                                    TextWrapping="Wrap" />
                                                <Button
                                                    HorizontalAlignment="Left"
                                                    Click="OnOpenNotificationSettingsClicked"
                                                    Content="Open Windows notification settings" />
                                            </StackPanel>
                                        </Border>
                                        <ToggleSwitch
                                            x:Name="ClockToggle"
                                            Header="Clock glance"
                                            Toggled="OnClockToggled" />
                                        <Grid>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Foreground="{StaticResource NyKurTextBrush}"
                                                Text="Clock interval" />
                                            <ComboBox
                                                x:Name="ClockIntervalCombo"
                                                MinWidth="132"
                                                HorizontalAlignment="Right"
                                                SelectionChanged="OnClockIntervalChanged">
                                                <ComboBoxItem Content="15 minutes" Tag="15" />
                                                <ComboBoxItem Content="30 minutes" Tag="30" />
                                                <ComboBoxItem Content="Hourly" Tag="60" />
                                                <ComboBoxItem Content="2 hours" Tag="120" />
                                            </ComboBox>
                                        </Grid>
                                        <Button
                                            HorizontalAlignment="Left"
                                            Click="OnPreviewClockClicked"
                                            Content="Preview clock glance" />
                                    </StackPanel>
                                </Border>

                                <Button
                                    HorizontalAlignment="Left"
                                    Click="OnExitClicked"
                                    Content="Exit NyKur Edge"
                                    Foreground="#FFD9A0A8" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <Border
                        x:Name="GlanceOverlay"
                        Background="#FA14161A"
                        CornerRadius="20"
                        IsHitTestVisible="False"
                        Opacity="0">
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="7">
                            <TextBlock
                                HorizontalAlignment="Center"
                                Style="{StaticResource NyKurSectionLabelStyle}"
                                Text="{x:Bind ViewModel.GlanceEyebrow, Mode=OneWay}" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontFamily="Segoe UI Variable Display"
                                FontSize="54"
                                FontWeight="SemiLight"
                                Foreground="{StaticResource NyKurTextBrush}"
                                Text="{x:Bind ViewModel.GlancePrimary, Mode=OneWay}" />
                            <Rectangle
                                Width="34"
                                Height="2"
                                Margin="0,2"
                                Fill="{StaticResource NyKurAccentBrush}"
                                RadiusX="1"
                                RadiusY="1" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="13"
                                Foreground="{StaticResource NyKurMutedTextBrush}"
                                Text="{x:Bind ViewModel.GlanceSecondary, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                </Grid>

            <Grid
                x:Name="EdgeSurface"
                Width="82"
                HorizontalAlignment="Right"
                Background="#01000000">
                <Border
                    x:Name="EdgeAnchor"
                    Width="14"
                    Height="272"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="{StaticResource NyKurAccentFaintBrush}"
                    CornerRadius="7,0,0,7"
                    Opacity="0.42" />

                <Path
                    x:Name="WaveBloom"
                    IsHitTestVisible="False"
                    Opacity="0.56"
                    Stroke="{StaticResource NyKurAccentFaintBrush}"
                    StrokeEndLineCap="Round"
                    StrokeLineJoin="Round"
                    StrokeStartLineCap="Round"
                    StrokeThickness="13" />
                <Path
                    x:Name="WaveOuterTrace"
                    IsHitTestVisible="False"
                    Opacity="0.48"
                    Stroke="{StaticResource NyKurAccentSoftBrush}"
                    StrokeEndLineCap="Round"
                    StrokeLineJoin="Round"
                    StrokeStartLineCap="Round"
                    StrokeThickness="1.05" />
                <Path
                    x:Name="WaveSecondaryTrace"
                    IsHitTestVisible="False"
                    Opacity="0.38"
                    Stroke="{StaticResource NyKurGlassTraceBrush}"
                    StrokeEndLineCap="Round"
                    StrokeLineJoin="Round"
                    StrokeStartLineCap="Round"
                    StrokeThickness="0.85" />
                <Path
                    x:Name="WaveCoreTrace"
                    IsHitTestVisible="False"
                    Opacity="0.82"
                    Stroke="{StaticResource NyKurAccentBrush}"
                    StrokeEndLineCap="Round"
                    StrokeLineJoin="Round"
                    StrokeStartLineCap="Round"
                    StrokeThickness="1.35" />

                <Ellipse
                    x:Name="IncomingNotificationPulse"
                    Width="4"
                    Height="4"
                    Margin="0,42,15,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Fill="{StaticResource NyKurAccentBrush}"
                    IsHitTestVisible="False"
                    Opacity="0" />

                <Grid
                    x:Name="EdgeBubbleRoot"
                    Width="48"
                    Height="48"
                    Margin="0,0,-2,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False">
                    <Ellipse
                        x:Name="NotificationHaloPrimary"
                        Width="26"
                        Height="26"
                        Fill="{StaticResource NyKurAccentFaintBrush}"
                        Opacity="0"
                        Stroke="{StaticResource NyKurAccentSoftBrush}"
                        StrokeThickness="0.8" />
                    <Ellipse
                        x:Name="NotificationHaloSecondary"
                        Width="26"
                        Height="26"
                        Fill="Transparent"
                        Opacity="0"
                        Stroke="{StaticResource NyKurGlassTraceBrush}"
                        StrokeThickness="0.7" />
                    <Ellipse
                        x:Name="UnreadRing"
                        Width="31"
                        Height="31"
                        Opacity="0"
                        Stroke="{StaticResource NyKurAccentBrush}"
                        StrokeThickness="0.65" />

                    <Grid
                        x:Name="BubbleBreathHost"
                        Width="26"
                        Height="26">
                        <Grid
                            x:Name="BubbleBody"
                            Width="26"
                            Height="26">
                            <Ellipse
                                Width="38"
                                Height="38"
                                Fill="{StaticResource NyKurAccentFaintBrush}"
                                Opacity="0.62" />
                            <Ellipse
                                Width="30"
                                Height="30"
                                Fill="#28111720"
                                Stroke="{StaticResource NyKurAccentSoftBrush}"
                                StrokeThickness="0.6" />
                            <Ellipse
                                Width="26"
                                Height="26"
                                Fill="#DC171D25"
                                Stroke="#78FFFFFF"
                                StrokeThickness="0.8" />
                            <Ellipse
                                Width="23"
                                Height="23"
                                Fill="{StaticResource NyKurAccentSoftBrush}"
                                Opacity="0.48" />
                            <Ellipse
                                Width="16"
                                Height="10"
                                Margin="3,3,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Fill="#54FFFFFF"
                                Opacity="0.76" />
                            <Ellipse
                                Width="4"
                                Height="4"
                                Margin="6,5,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Fill="#D8FFFFFF" />

                            <Grid
                                x:Name="NotificationIconHost"
                                Width="15"
                                Height="15"
                                Opacity="0">
                                <FontIcon
                                    FontSize="9"
                                    Foreground="#E8FFFFFF"
                                    Glyph="&#xEA8F;" />
                                <Border CornerRadius="7.5">
                                    <Image
                                        Source="{x:Bind ViewModel.NotificationIcon, Mode=OneWay}"
                                        Stretch="UniformToFill" />
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
