<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="NyKurEdge.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <Grid
        x:Name="InteractionRoot"
        Background="#01000000"
        PointerEntered="OnPointerEntered"
        PointerExited="OnPointerExited">
        <Grid
            x:Name="LayoutGrid"
            Width="96"
            HorizontalAlignment="Left">
            <Grid
                x:Name="EdgeSurface"
                Width="96"
                HorizontalAlignment="Right"
                Background="Transparent">
                <canvas:CanvasControl
                    x:Name="FluidCanvas"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    IsHitTestVisible="False" />
                <canvas:CanvasControl
                    x:Name="FluidCanvasSecondary"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    IsHitTestVisible="False" />

                <Grid
                    x:Name="PanelContent"
                    Margin="26,24,30,24"
                    IsHitTestVisible="False"
                    Opacity="0"
                    Visibility="Collapsed">
                    <Grid.RenderTransform>
                        <CompositeTransform
                            x:Name="PanelTransform"
                            ScaleX="0.96"
                            ScaleY="0.96"
                            TranslateX="18" />
                    </Grid.RenderTransform>

                    <Grid x:Name="MediaSurface">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="96" />
                            <RowDefinition Height="40" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="104" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="1"
                            Margin="18,3,42,0"
                            FontSize="10"
                            FontWeight="SemiBold"
                            CharacterSpacing="165"
                            Foreground="{StaticResource NyKurAccentBrush}"
                            Text="{x:Bind ViewModel.MediaSource, Mode=OneWay}" />

                        <Border
                            Grid.Row="1"
                            Width="96"
                            Height="96"
                            Margin="0,9,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="#161C222A"
                            CornerRadius="24">
                            <Grid>
                                <FontIcon
                                    FontSize="22"
                                    Foreground="{StaticResource NyKurAccentSoftBrush}"
                                    Glyph="&#xE8D6;" />
                                <Image
                                    Source="{x:Bind ViewModel.Artwork, Mode=OneWay}"
                                    Stretch="UniformToFill" />
                                <Border
                                    BorderBrush="#2EFFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="24" />
                            </Grid>
                        </Border>

                        <StackPanel
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="18,13,0,0"
                            VerticalAlignment="Top"
                            Spacing="4">
                            <TextBlock
                                FontFamily="Segoe UI Variable Display"
                                FontSize="21"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource NyKurTextBrush}"
                                MaxLines="2"
                                Text="{x:Bind ViewModel.MediaTitle, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{StaticResource NyKurMutedTextBrush}"
                                MaxLines="1"
                                Text="{x:Bind ViewModel.MediaArtist, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <Grid
                            Grid.Row="2"
                            Grid.Column="1"
                            Margin="18,0,0,0"
                            VerticalAlignment="Bottom">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Slider
                                x:Name="MediaProgressSlider"
                                Height="20"
                                Margin="-4,0,-4,0"
                                IsEnabled="{x:Bind ViewModel.IsMediaAvailable, Mode=OneWay}"
                                Maximum="1"
                                Minimum="0"
                                PointerReleased="OnMediaProgressPointerReleased"
                                Value="{x:Bind ViewModel.MediaProgress, Mode=OneWay}" />
                            <Grid Grid.Row="1" Margin="1,-2,1,0">
                                <TextBlock
                                    Style="{StaticResource NyKurCaptionStyle}"
                                    Text="{x:Bind ViewModel.PositionText, Mode=OneWay}" />
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource NyKurCaptionStyle}"
                                    Text="{x:Bind ViewModel.DurationText, Mode=OneWay}" />
                            </Grid>
                        </Grid>

                        <StackPanel
                            Grid.Row="3"
                            Grid.Column="1"
                            Margin="18,10,0,0"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="13">
                            <Button
                                AutomationProperties.Name="Previous track"
                                Click="OnPreviousClicked"
                                Content="&#xE892;"
                                IsEnabled="{x:Bind ViewModel.IsMediaAvailable, Mode=OneWay}"
                                Style="{StaticResource NyKurTransportButtonStyle}" />
                            <Button
                                AutomationProperties.Name="Play or pause"
                                Click="OnPlayPauseClicked"
                                Content="{x:Bind ViewModel.PlayPauseGlyph, Mode=OneWay}"
                                IsEnabled="{x:Bind ViewModel.IsMediaAvailable, Mode=OneWay}"
                                Style="{StaticResource NyKurPrimaryTransportButtonStyle}" />
                            <Button
                                AutomationProperties.Name="Next track"
                                Click="OnNextClicked"
                                Content="&#xE893;"
                                IsEnabled="{x:Bind ViewModel.IsMediaAvailable, Mode=OneWay}"
                                Style="{StaticResource NyKurTransportButtonStyle}" />
                        </StackPanel>
                    </Grid>

                    <Grid
                        x:Name="NotificationSurface"
                        Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="62" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid
                            Width="46"
                            Height="46"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                            <FontIcon
                                FontSize="17"
                                Foreground="{StaticResource NyKurAccentBrush}"
                                Glyph="&#xEA8F;" />
                            <Image
                                Source="{x:Bind ViewModel.NotificationIcon, Mode=OneWay}"
                                Stretch="UniformToFill" />
                        </Grid>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="5">
                            <Grid>
                                <TextBlock
                                    FontSize="10"
                                    FontWeight="SemiBold"
                                    CharacterSpacing="145"
                                    Foreground="{StaticResource NyKurAccentBrush}"
                                    Text="{x:Bind ViewModel.NotificationApplication, Mode=OneWay}" />
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource NyKurCaptionStyle}"
                                    Text="{x:Bind ViewModel.NotificationTime, Mode=OneWay}" />
                            </Grid>
                            <TextBlock
                                FontFamily="Segoe UI Variable Display"
                                FontSize="19"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource NyKurTextBrush}"
                                MaxLines="1"
                                Text="{x:Bind ViewModel.NotificationTitle, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{StaticResource NyKurMutedTextBrush}"
                                MaxLines="2"
                                Text="{x:Bind ViewModel.NotificationMessage, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>

                    <Grid
                        x:Name="GlanceOverlay"
                        Background="#E20A0E14"
                        IsHitTestVisible="False"
                        Opacity="0">
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="3">
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="10"
                                FontWeight="SemiBold"
                                CharacterSpacing="180"
                                Foreground="{StaticResource NyKurAccentBrush}"
                                Text="{x:Bind ViewModel.GlanceEyebrow, Mode=OneWay}" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontFamily="Segoe UI Variable Display"
                                FontSize="58"
                                FontWeight="SemiLight"
                                Foreground="{StaticResource NyKurTextBrush}"
                                Text="{x:Bind ViewModel.GlancePrimary, Mode=OneWay}" />
                            <Border
                                Width="30"
                                Height="2"
                                Margin="0,5"
                                Background="{StaticResource NyKurAccentBrush}"
                                CornerRadius="1"
                                Opacity="0.66" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="12"
                                Foreground="{StaticResource NyKurMutedTextBrush}"
                                Text="{x:Bind ViewModel.GlanceSecondary, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>

                    <Button
                        x:Name="PanelSettingsButton"
                        Width="32"
                        Height="32"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="Open settings"
                        Background="#08FFFFFF"
                        BorderBrush="#10FFFFFF"
                        BorderThickness="1"
                        Click="OnSettingsClicked"
                        CornerRadius="16"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="13"
                        Foreground="#BCEFF3F7"
                        IsTabStop="False"
                        Content="&#xE713;" />
                </Grid>

                <Grid
                    x:Name="NotificationIconHost"
                    Width="20"
                    Height="20"
                    Margin="0,0,19,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False"
                    Opacity="0">
                    <Grid.RenderTransform>
                        <CompositeTransform
                            x:Name="NotificationIconTransform"
                            ScaleX="0.72"
                            ScaleY="0.72" />
                    </Grid.RenderTransform>
                    <FontIcon
                        FontSize="10"
                        Foreground="#F2FFFFFF"
                        Glyph="&#xEA8F;" />
                    <Border CornerRadius="10">
                        <Image
                            Source="{x:Bind ViewModel.NotificationIcon, Mode=OneWay}"
                            Stretch="UniformToFill" />
                    </Border>
                </Grid>

                <Button
                    x:Name="EdgeLauncherButton"
                    Width="52"
                    Height="104"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Open or pin NyKur Edge"
                    Background="#01000000"
                    BorderThickness="0"
                    Click="OnEdgeLauncherClicked"
                    IsTabStop="False"
                    Padding="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="{TemplateBinding Background}" />
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Page>
